# ==============================================================================
# Dhwani / EchoShield AI - Environment Configuration Template
# Copy this file to .env and configure local values. NEVER commit secrets.
# ==============================================================================

# Twilio Programmable Voice Configuration (Required for Live Telephony)
TWILIO_ACCOUNT_SID=AC_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_STREAM_PUBLIC_URL=wss://YOUR_NGROK_SUBDOMAIN.ngrok-free.app/twilio/media

# Optional Twilio API Keys
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Multi-Channel Alert & Notification Destinations
DHWANI_ALERT_PHONE_NUMBER=+1987654321
DHWANI_ALERT_DRY_RUN=true

# Twilio WhatsApp Integration (Optional: only enable if account has verified WhatsApp sender)
DHWANI_WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DHWANI_WHATSAPP_ALERT_NUMBER=whatsapp:+1987654321

# Email / SMTP Fallback Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DHWANI_ALERT_EMAIL=
DHWANI_FROM_EMAIL=alerts@dhwani.ai

# Privacy & Ephemeral Audio Retention
# Set to true only if legally authorized to retain permanent conversation recordings
DHWANI_RETAIN_AUDIO=false
